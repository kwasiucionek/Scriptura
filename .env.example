# --- Django ---
SECRET_KEY=change-me
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
# za Cloudflare/nginx (Mikrus): true -> X-Forwarded-Proto, bezpieczne ciasteczka, bez redirectu na https
BEHIND_PROXY=false
LOG_LEVEL=INFO

# --- Baza danych ---
# dev: sqlite:///db.sqlite3   prod: postgres://user:pass@localhost:5432/scriptura
DATABASE_URL=sqlite:///db.sqlite3

# --- Katalog z pobranymi korpusami (OSHB, MorphGNT, przekłady JSON) ---
DATA_DIR=./data

# --- Wyszukiwanie: opensearch | db ---
SEARCH_BACKEND=opensearch
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_USER=
OPENSEARCH_PASSWORD=
OPENSEARCH_VERIFY_CERTS=true
OPENSEARCH_INDEX_PREFIX=scriptura

# --- Harvest ---
MANIFESTS_DIR=./data/manifests
HARVEST_MAILTO=
# pobieranie plików zza zapory (OPEN ICM: Anubis + captcha ICM) — ciasteczko i UA z przeglądarki
HARVEST_COOKIE=
HARVEST_USER_AGENT=
HARVEST_ACCEPT_LANGUAGE=pl,en-US;q=0.9,en;q=0.8
HARVEST_REFERER_TEMPLATE={origin}/captcha.html?protected={path}%3f
HARVEST_REFERER_HOSTS=open.icm.edu.pl
SERPAPI_KEY=

# --- LLM / embeddingi: ollama | echo ---
LLM_BACKEND=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=
OLLAMA_CHAT_MODEL=qwen3.5:122b-cloud
OLLAMA_EMBED_MODEL=snowflake-arctic-embed2
EMBEDDING_DIM=1024
EMBEDDING_QUERY_PREFIX="query: "
RAG_THINK=false

# --- Embeddingi: ollama | tei  (tei = lokalny TEI albo HF Inference Endpoint z tym samym modelem) ---
EMBEDDINGS_BACKEND=ollama
TEI_EMBED_URL=http://localhost:8080
TEI_TOKEN=

# --- Reranker: tei | none  (lokalnie: usługa reranker w compose; chmura: HF Endpoint + TEI_TOKEN) ---
RERANKER_BACKEND=tei
# llm: reranker w modelu czatu (bez GPU); próg 0–3 i długość fragmentu
RERANK_LLM_MIN_SCORE=1.0
RERANK_LLM_MAX_CHARS=700
TEI_RERANK_URL=http://localhost:8081
RERANK_TOP_N=20
RERANK_MAX_CHARS=1800

# --- RAG ---
RAG_TOP_K=8
# dywersyfikacja źródeł: max chunków z jednego dokumentu w top-k (0 = bez limitu)
RAG_MAX_PER_DOC=3
RAG_CONTEXT_NEIGHBORS=1
RAG_TRANSLATE_QUERY=true
RAG_TRANSLATE_MODEL=
RAG_RELATED_VERSES=6
RAG_ANE_PASSAGES=3
RAG_PATRISTIC_PASSAGES=4
# przekład chunków obcych na polski (jednorazowo, lokalnie): ollama pull translategemma:27b
TRANSLATE_MODEL=translategemma:27b
TRANSLATE_BASE_URL=
# kurator manifestów (ocena wstępna nowych pozycji przez model)
CURATE_MODEL=
CURATE_REVIEW_CONFIDENCE=0.5
# tryb odpowiedzi: scientific (bibliści, filtr źródeł naukowych) | popular (dla każdego)
RAG_DEFAULT_MODE=scientific
RAG_REGISTER_MODE=soft
RAG_ACCESS=open
RAG_VERSE_WORKS=BG1632,SBLGNT,WLC,LXX
RAG_TEMPERATURE=0.2
RAG_NUM_CTX=16384
DEMO_TOKEN=
# limity pytań na godzinę (anonim per IP / konto) i długość pytania
RATE_LIMIT_ANON=20
RATE_LIMIT_USER=200
QUESTION_MAX_CHARS=1000
CACHE_DIR=
# konta: anonimowi mogą pytać? (tylko źródła open, tryb popularny)
ALLOW_ANONYMOUS=true
ANONYMOUS_POPULAR_ONLY=true
# materiały osobiste użytkowników: limit rozmiaru pliku (MB) i liczby plików na konto
PERSONAL_MAX_MB=25
PERSONAL_MAX_DOCS=50
