# /opt/scriptura/.env — produkcja (Mikrus). UWAGA: EnvironmentFile systemd nie tnie komentarzy w liniach z wartością —
# ten plik ma komentarze tylko w osobnych liniach.
DEBUG=false
SECRET_KEY=WSTAW_WYNIK_python3_-c_import_secrets_print_secrets.token_urlsafe_50
ALLOWED_HOSTS=scriptura.cytr.us
CSRF_TRUSTED_ORIGINS=https://scriptura.cytr.us
BEHIND_PROXY=true
DATABASE_URL=sqlite:////cytrus/scriptura/db.sqlite3
DATA_DIR=/cytrus/scriptura/data
MANIFESTS_DIR=/cytrus/scriptura/data/manifests
CACHE_DIR=/cytrus/scriptura/cache

SEARCH_BACKEND=opensearch
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX_PREFIX=scriptura

LLM_BACKEND=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=
OLLAMA_CHAT_MODEL=gemma4:31b-cloud
RAG_THINK=false

EMBEDDINGS_BACKEND=ollama
OLLAMA_EMBED_MODEL=snowflake-arctic-embed2
EMBEDDING_DIM=1024
EMBEDDING_QUERY_PREFIX=query: 

RERANKER_BACKEND=llm
RERANK_TOP_N=20
RERANK_LLM_MIN_SCORE=1.0
RERANK_LLM_MAX_CHARS=700

RAG_TOP_K=8
RAG_MAX_PER_DOC=3
RAG_CONTEXT_NEIGHBORS=1
RAG_TRANSLATE_QUERY=true
RAG_RELATED_VERSES=6
RAG_ANE_PASSAGES=3
RAG_PATRISTIC_PASSAGES=4
RAG_DEFAULT_MODE=popular
RAG_REGISTER_MODE=soft
RAG_ACCESS=open
RAG_VERSE_WORKS=BG1632,SBLGNT,WLC,LXX

ALLOW_ANONYMOUS=true
ANONYMOUS_POPULAR_ONLY=true
RATE_LIMIT_ANON=60
RATE_LIMIT_USER=0
QUESTION_MAX_CHARS=1000
PERSONAL_MAX_MB=25
PERSONAL_MAX_DOCS=50

TRANSLATE_MODEL=gemma4:31b-cloud
CURATE_MODEL=
CURATE_REVIEW_CONFIDENCE=0.5
HARVEST_MAILTO=
